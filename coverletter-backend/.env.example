# App environment (production disables /docs and enables TrustedHost)
ENV=development

# Database — deliberately separate from the Sweeps backend's DB, since this
# product has its own accounts and will eventually be billed independently.
DATABASE_URL=postgresql+asyncpg://coverletters:coverletters@localhost:5433/coverletters

# Google OAuth (create a separate OAuth client, or add this redirect URI to
# an existing one — scopes here only request identity, no Gmail/Calendar)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback

# App
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Comma-separated; leave empty to allow any Google account to sign up
ALLOWED_EMAILS=
TRUSTED_HOSTS=localhost,127.0.0.1

# JWT expiry (minutes) — 24 hours; re-login after expiry
JWT_EXPIRE_MINUTES=1440

# Rate limiting (set false to disable in local dev if needed)
RATE_LIMIT_ENABLED=true

# Google Gemini (get a free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Cloudflare R2 (S3-compatible object storage) — create a bucket + API token
# at https://dash.cloudflare.com/ under R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=cover-letter-studio
R2_PRESIGNED_URL_EXPIRE_SECONDS=3600

# Max resume/document upload size in bytes (default 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760
